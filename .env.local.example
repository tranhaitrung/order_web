# Tạo bot qua @BotFather trên Telegram, thêm bot vào group/kênh nhận đơn,
# lấy chat_id (vd: dùng https://api.telegram.org/bot<token>/getUpdates sau khi gửi 1 tin nhắn thử trong group).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Kết nối PostgreSQL (menu sản phẩm + đơn hàng).
# Chạy `docker compose up -d db` để có Postgres local khớp với giá trị mặc định bên dưới.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/it_house_ordering

# Dùng Supabase/Neon thay vì Postgres tự host: dán nguyên connection string nhà cung cấp đưa
# cho bạn vào DATABASE_URL — kể cả khi nó có sẵn ?sslmode=require&channel_binding=require (Neon)
# hoặc ?sslmode=require (Supabase), app tự nhận diện và cấu hình SSL đúng cách, không cần sửa gì.
# Ví dụ Supabase:
# DATABASE_URL=postgresql://postgres.xxxxxxxx:your-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# Ví dụ Neon:
# DATABASE_URL=postgresql://neondb_owner:your-password@ep-xxxx.aws.neon.tech/your-db?sslmode=require&channel_binding=require

# Đăng nhập trang quản trị /admin (Basic Auth).
ADMIN_USERNAME=
ADMIN_PASSWORD=
